                  (pt 5121000 -588000)
                  (angle 90)
                  (padstackGroup default (padstack c375h250))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape NHD-0208BZ-FL-YBW.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

